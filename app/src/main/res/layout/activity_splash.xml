<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#000000"
    android:gravity="center">

    <ImageView
        android:id="@+id/splashSymbol"
        android:layout_width="13.74dp"
        android:layout_height="31.53dp"
        android:src="@drawable/ic_symbol_white"
        android:layout_marginBottom="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/splashLogotype"/>

    <ImageView
        android:id="@+id/splashLogotype"
        android:layout_width="222.35dp"
        android:layout_height="48.54dp"
        android:src="@drawable/ic_logotype_white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/kakao_login_btn"/>

    <TextView
        android:id="@+id/splashSlogan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/splashSlogan"
        android:textColor="@color/G000"
        android:textSize="17sp"
        android:fontFamily="@font/pretendard_medium"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@id/splashLogotype"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/kakao_login_btn"
        android:layout_width="320dp"
        android:layout_height="60dp"
        android:src="@drawable/img_kakao_login_wide"
        android:layout_marginBottom="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <ImageView
        android:id="@+id/naver_login_btn"
        android:layout_width="320dp"
        android:layout_height="40dp"
        app:layout_constraintBottom_toTopOf="@id/kakao_login_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/img_naver_login"/>

</androidx.constraintlayout.widget.ConstraintLayout>
